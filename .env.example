# StatusBrasil — environment variables
#
# Copy this file to `.env.local` (git-ignored) and fill in the values you need.
# All variables are optional in development unless noted otherwise. The pino
# logger redacts sensitive keys (`src/lib/logger.ts:REDACT_KEYS`); keep that
# list in sync with this file when introducing a new secret (`/add-secret-env`).

# ──────────────────────────────────────────────────────────────────────────────
# Gatus — uptime probe source (see ADR-0003)
# ──────────────────────────────────────────────────────────────────────────────

# Driver selector: "stub" (deterministic fixtures, default) or "http" (real Gatus).
GATUS_DRIVER=stub

# Base URL of the Gatus instance. Required when GATUS_DRIVER=http.
GATUS_API_URL=https://gatus.example.com

# Bearer token for Gatus' API. Required only if the Gatus instance is protected.
GATUS_API_TOKEN=

# ──────────────────────────────────────────────────────────────────────────────
# Persistence — aggregates and cache (see ADR-0004)
# ──────────────────────────────────────────────────────────────────────────────

# Postgres connection string for derived aggregates. Required in production.
DATABASE_URL=postgres://user:password@localhost:5432/statusbrasil

# Upstash Redis (HTTP transport) — backs the @upstash/ratelimit helper.
# Both vars must be set together; if either is absent the rate limiter
# fails open (every request passes), which is the dev-friendly default.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ──────────────────────────────────────────────────────────────────────────────
# Internal endpoints — secrets that gate non-public routes
# ──────────────────────────────────────────────────────────────────────────────

# Shared secret required by the cron endpoint that refreshes aggregates.
# Required in production. Generate with: `openssl rand -hex 32`.
CRON_SECRET=

# Shared secret required by the metrics scrape endpoint. Required in production.
# Generate with: `openssl rand -hex 32`.
METRICS_SECRET=

# ──────────────────────────────────────────────────────────────────────────────
# Observability
# ──────────────────────────────────────────────────────────────────────────────

# Sentry DSN for the Node runtime. If unset, server-side Sentry init is skipped.
SENTRY_DSN=

# Sentry DSN for the browser runtime. Public — exposed to the client bundle.
# If unset, client-side Sentry init is skipped.
NEXT_PUBLIC_SENTRY_DSN=

# pino log level: trace | debug | info | warn | error | fatal.
# Leave unset to use the in-code default ("debug" in dev, "info" in prod).
# LOG_LEVEL=info

# ──────────────────────────────────────────────────────────────────────────────
# Site configuration
# ──────────────────────────────────────────────────────────────────────────────

# Canonical public URL. Used to build absolute URLs (sitemaps, OpenGraph, etc).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Plausible site identifier (the value used as `data-domain` on the analytics
# script). Required to enable Plausible; if unset, the script is not loaded.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Disable Next.js anonymous telemetry collection during builds.
# https://nextjs.org/telemetry
NEXT_TELEMETRY_DISABLED=1
