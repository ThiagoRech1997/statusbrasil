{
  "name": "status-brasil",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "tsc --noEmit",
    "ci": "biome ci",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/db-migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "seed": "tsx scripts/seed.ts",
    "openapi:write": "tsx scripts/openapi-write.ts",
    "openapi:validate": "tsx scripts/openapi-write.ts && swagger-cli validate .openapi/spec.json",
    "analyze": "ANALYZE=true pnpm build"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@base-ui/react": "^1.7.0",
    "@scalar/api-reference-react": "^0.9.66",
    "@sentry/nextjs": "^10.56.0",
    "@tanstack/react-table": "^8.21.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "@visx/axis": "^3.12.0",
    "@visx/scale": "^3.12.0",
    "@visx/shape": "^3.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.35.0",
    "next": "16.3.3",
    "next-intl": "^4.14.1",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.1"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.2"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@electric-sql/pglite": "^0.5.8",
    "@next/bundle-analyzer": "^16.3.3",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-playwright": "^2.2.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "pino-pretty": "^13.1.3",
    "rss-parser": "^3.13.0",
    "swagger-cli": "^4.0.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
