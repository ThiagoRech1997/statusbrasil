    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "axe-playwright": "^2.2.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
